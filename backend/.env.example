# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Job Finder"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Sessions
SECRET_KEY=jobfinder-dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=jf_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database (PostgreSQL for Docker/Production, SQLite supported for local dev/testing)
DATABASE_URL=sqlite:///./jobfinder.db
# DATABASE_URL=postgresql://jobfinder:jobfinder@localhost:5432/jobfinder

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Optional SMTP Email Configuration (If omitted, verification tokens are safely logged in dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=support@jobfinder.local
EMAILS_FROM_NAME="Job Finder"

# Optional LLM API Key (Not required for Phase 1 signup, dashboard, or health checks)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Storage
STORAGE_BACKEND=local
STORAGE_DIR=./uploads
