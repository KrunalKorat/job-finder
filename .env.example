# ==============================================================================
# Job Finder Platform — Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="Job Finder"
VERSION=1.0.0

# Frontend & Public URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_PUBLIC_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL for Docker, SQLite supported for local dev)
DATABASE_URL=postgresql://jobfinder:jobfinder@localhost:5432/jobfinder
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=jobfinder
POSTGRES_DB=jobfinder
POSTGRES_PORT=5432

# Redis & Queues
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security & Session Configuration
# CRITICAL: In production, generate a secure random 32+ character key
SECRET_KEY=jobfinder-dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=jf_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional Email Dispatch (Safe development console fallback when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=support@jobfinder.local
EMAILS_FROM_NAME="Job Finder"

# Optional LLM / AI Services (NOT required for Phase 1 signup, dashboard, or health checks)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Storage & Upload Limits
STORAGE_BACKEND=local
STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
